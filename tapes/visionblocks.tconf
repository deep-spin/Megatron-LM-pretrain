global {
    ducttape_output=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_outputs_visionblocks
    repo=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain

    # multimodal model parameters
    # (base lm, tp, etc...)
    clip_original_dir=/lustre/fswork/projects/rech/qjm/ued79zb/clip_model_og/
    model_name=(
        TextModel:
            qwen2p5_7b="Qwen/Qwen2.5-7B-Instruct"
            eurollm_9b="utter-project/EuroLLM-9B-Instruct"
            qwen2p5_14b="Qwen/Qwen2.5-14B-Instruct"
            towerq_14b="/lustre/fsn1/projects/rech/qjm/uar73ie/sft_ckpts/qwen-2p5-14b-Blocks-v4-250225"
    )
    model_type=(
        TextModel:
            qwen2p5_7b="qwen2.5-7B"
            eurollm_9b="eurollm-9B"
            qwen2p5_14b="qwen2.5-14B"
            towerq_14b="qwen2.5-14B"
    )
    prompt_format=(
        TextModel:
            qwen2p5_7b="qwen2p0"
            eurollm_9b="chatml"
            qwen2p5_14b="qwen2p0"
            towerq_14b="qwen2p0"
    )
    image_preproc=nvlm
    pixel_shuffle=true
    tp=4
    pp=1

    # pre-training arguments
    external_model_dir=(
        TextModel:
            qwen2p5_7b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_ckpts/qwen2p5_7b_instruct_prt
            eurollm_9b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_ckpts/eurollm_9b_instruct_prt
            qwen2p5_14b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_ckpts/qwen2p5_14b_instruct_prt
            towerq_14b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_ckpts/towerq_14b_instruct_prt
    )
    external_tensorboard=(
        TextModel:
            qwen2p5_7b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs/qwen2p5_7b_instruct_prt
            eurollm_9b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs/eurollm_9b_instruct_prt
            qwen2p5_14b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs/qwen2p5_14b_instruct_prt
            towerq_14b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs/towerq_14b_instruct_prt
    )
    pretrain_dataset=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/pixmo_caps.yaml
    pretrain_iters=5000
    pretrain_bsz=256
    pretrain_lr=0.001
    pretrain_lr_warmup=0.03
    pretrain_unfreeze_lm=false
    pretrain_unfreeze_vit=false
    pretrain_save_interval=5000
    pretrain_eval_interval=1000

    # fine-tuning arguments
    sft_dataset=(
        DatasetVersion:
            base=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/visionblocks_v2.yaml
            notblocks=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/visionblocks_v2_notblocks.yaml
            v3=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/visionblocks_v3.yaml
            v4=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/visionblocks_v4.yaml
            v4_tagged=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/visionblocks_v4_tagged.yaml
            v5=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/visionblocks_v5.yaml
    )
    finetune_model_dir=(
        TextModel:
            qwen2p5_7b=(
                DatasetVersion:
                    base=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft
                            2=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_ep2
                            3=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_ep3
                    )
                    notblocks=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks
                            2=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep2
                            3=(
                                FinetuneLR:
                                    1em6=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3
                                    2em6=(
                                        UnfreezeViT:
                                            false=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_2em6
                                            true=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_2em6_fullunfreeze
                                    )
                                    5em6=(
                                        UnfreezeViT:
                                            false=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_5em6
                                            true=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_5em6_fullunfreeze
                                        )
                                    1em5=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_1em5
                                    1em7=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_1em7
                            )
                    )
                    v3=(
                        Epochs:
                            1=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v3
                            2=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v3_ep2
                            3=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v3_ep3
                    )
                    v4=(
                        Epochs:
                            1=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v4
                            2=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v4_ep2
                            3=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v4_ep3
                    )
                    v4_tagged=(
                        Epochs:
                            1=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v4_tagged
                            2=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v4_tagged_ep2
                            3=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v4_tagged_ep3
                    )
                    v5=(
                        Epochs:
                            1=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v5
                            2=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v5_ep2
                            3=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_7b_instruct_sft_v5_ep3
                    )
            )
            eurollm_9b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/eurollm_9b_instruct_sft
            qwen2p5_14b=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/qwen2p5_14b_instruct_sft_1102_ep3
            towerq_14b=/lustre/fsn1/projects/rech/qjm/ued79zb/towervision_ckpts_vblocks/towerq_14b_instruct_sft_1102_ep3
    )
    finetune_tensorboard=(
        TextModel:
            qwen2p5_7b=(
                DatasetVersion:
                    base=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft
                            2=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_ep2
                            3=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_ep3
                    )
                    notblocks=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks
                            2=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep2
                            3=(
                                FinetuneLR:
                                    1em6=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3
                                    2em6=(
                                        UnfreezeViT:
                                            false=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_2em6
                                            true=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_2em6_fullunfreeze
                                    )
                                    5em6=(
                                        UnfreezeViT:
                                            false=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_3em6
                                            true=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_3em6_fullunfreeze
                                        )
                                    1em5=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_1em5
                                    1em7=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_notblocks_ep3_1em7
                            )
                    )
                    v3=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v3
                            2=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v3_ep2
                            3=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v3_ep3
                    )
                    v4=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v4
                            2=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v4_ep2
                            3=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v4_ep3
                    )
                    v4_tagged=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v4_tagged
                            2=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v4_tagged_ep2
                            3=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v4_tagged_ep3
                    )
                    v5=(
                        Epochs:
                            1=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v5
                            2=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v5_ep2
                            3=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_7b_instruct_sft_v5_ep3
                    )
            )
            eurollm_9b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/eurollm_9b_instruct_sft
            qwen2p5_14b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/qwen2p5_14b_instruct_sft_1102_ep3
            towerq_14b=/lustre/fswork/projects/rech/qjm/ued79zb/towervision_tbs_vblocks/towerq_14b_instruct_sft_1102_ep3
    )
    finetune_iters=(
        DatasetVersion:
            base=(
                Epochs:
                    1=10000
                    2=20000
                    3=30000
            )
            notblocks=(
                Epochs:
                    1=6000
                    2=12000
                    3=18000
            )
            v3=(
                Epochs:
                    1=6500
                    2=13000
                    3=19500
            )
            v4=(
                Epochs:
                    1=16200
                    2=32400
                    3=48600
            )
            v4_tagged=(
                Epochs:
                    1=16200
                    2=32400
                    3=48600
            )
            v5=(
                Epochs:
                    1=(TextModel: qwen2p5_7b=6150 eurollm_9b=6150 qwen2p5_14b=11750 towerq_14b=11750)
                    2=(TextModel: qwen2p5_7b=12300 eurollm_9b=12300 qwen2p5_14b=23500 towerq_14b=23500)
                    3=(TextModel: qwen2p5_7b=18450 eurollm_9b=18450 qwen2p5_14b=35250 towerq_14b=35250)
            )
    )
    finetune_bsz=(
        TextModel:
            qwen2p5_7b=480
            eurollm_9b=128
            qwen2p5_14b=256
            towerq_14b=256
    )
    finetune_micro_bsz=(
        TextModel:
            qwen2p5_7b=6
            eurollm_9b=4
            qwen2p5_14b=2
            towerq_14b=2
    )
    finetune_lr=(
        FinetuneLR:
            1em6=1e-6
            2em6=2e-6
            5em6=5e-6
            1em5=1e-5
            1em7=1e-7
    )
    finetune_lr_warmup=0.03
    finetune_unfreeze_vit=(UnfreezeViT: false true)
    finetune_save_interval=3250
    finetune_eval_interval=1000
    finetune_online_eval_config=/linkhome/rech/genrce01/ued79zb/repos/Megatron-LM-pretrain/examples/multimodal/online_textvqa_config.yaml
    finetune_nnodes=16
    #finetune_nnodes=4
    finetune_gpus=4
    master_port=29800

    num_workers=16

    # eval arguments
    coco_dir=/lustre/fswork/projects/rech/qjm/ued79zb/coco/
    coco_gt_path=/lustre/fswork/projects/rech/qjm/ued79zb/coco/coco_karpathy_test.json
    textvqa_dir=/lustre/fswork/projects/rech/qjm/ued79zb/text_vqa/train_images
    textvqa_gt_path=/lustre/fswork/projects/rech/qjm/ued79zb/text_vqa/TextVQA_0.5.1_val.json
    ai2d_dir=/lustre/fswork/projects/rech/qjm/ued79zb/ai2diagram/AI2D_TEST
    ai2d_gt_path=/lustre/fswork/projects/rech/qjm/ued79zb/ai2diagram/test_vlmevalkit.jsonl
    eval_bsz=1
    use_tag=(UseEvalTag: false true)

    # convert arguments
    # upload_id="patricksf/mistral-7b-clip-prt"
    prt_upload_id=(
        TextModel:
            qwen2p5_7b="Unbabel/qwen2p5-7b-hdr-prt-pixcaps"
            eurollm_9b="Unbabel/eurollm-9b-hdr-prt-pixcaps"
            qwen2p5_14b="Unbabel/qwen2p5-14b-hdr-prt-pixcaps"
            towerq_14b="Unbabel/towerq-14b-hdr-prt-pixcaps"
    )
    sft_upload_id=(
        TextModel:
            qwen2p5_7b=(
                DatasetVersion:
                    base="Unbabel/qwen2p5-7b-hdr-sft-visionblocks-v0.3"
                    notblocks="Unbabel/qwen2p5-7b-hdr-sft-visionblocks-v0.3-notblocks"
                    v3="Unbabel/qwen2p5-7b-hdr-sft-visionblocks-v0.3.1"
                    v4="Unbabel/qwen2p5-7b-hdr-sft-visionblocks-v0.4"
                    v4_tagged="Unbabel/qwen2p5-7b-hdr-sft-visionblocks-v0.4-tagged"
                    v5="Unbabel/qwen2p5-7b-hdr-sft-visionblocks-1102-v1-midtraining"
            )
            eurollm_9b="Unbabel/eurollm-9b-hdr-sft-visionblocks-v0.2"
            qwen2p5_14b="Unbabel/qwen2p5-14b-hdr-sft-visionblocks-1102-v1"
            towerq_14b="Unbabel/towerq-14b-hdr-sft-visionblocks-1102-v1"
    )
    hf_model_type=nvlm_d

    # -- submitter arguments --
    submitter=scslurm

    prepare_C="h100"
    #prepare_account="qjm@cpu"
    prepare_account="qjm@h100"
    prepare_time="1:00:00"
    #prepare_gres="none"
    prepare_gres="gpu:1"
    prepare_partition=none
    prepare_cpus=24
    #prepare_partition="prepost"
    #prepare_cpus=32

    pretrain_C="h100"
    pretrain_account="qjm@h100"
    pretrain_time="20:00:00"
    pretrain_cpus=80
    pretrain_gres="gpu:4"

    finetune_C="h100"
    finetune_account="qjm@h100"
    finetune_time="20:00:00"
    #finetune_time="99:00:00"
    finetune_cpus=80
    finetune_nodes=16
    #finetune_nodes=4
    finetune_gres="gpu:4"
    #finetune_qos="qos_gpu_h100-t4"
    finetune_qos="none"

    eval_C="h100"
    eval_account="qjm@h100"
    eval_time="2:00:00"
    eval_cpus=80
    eval_gres="gpu:4"

    convert_account="qjm@cpu"
    convert_time="1:00:00"
    convert_cpus=4
    convert_partition="prepost"
}